# =====================================================================
# StoryTech 환경 변수 템플릿
#   로컬: 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local 은 git 에 올리지 않음)
#   배포: AWS Amplify Console → 앱 선택 → Hosting → Environment variables 에 같은 이름으로 등록
#         (amplify.yml 이 빌드 시 .env.production 으로 주입)
# =====================================================================


# ---------------------------------------------------------------------
# OpenAI — 익명화 · 감정 분석 · 문장 교정 · 번역
# ---------------------------------------------------------------------
# 1. https://platform.openai.com 로그인 (조직의 Owner 또는 API 키 생성 권한이 있는 Member)
# 2. 좌측 상단 조직/프로젝트 선택 → 우측 상단 Settings(톱니바퀴) → API keys
# 3. [+ Create new secret key] → Owned by: You 또는 Service account, Project: 사용할 프로젝트 선택
#    → Permissions: All (또는 Restricted 에서 Model capabilities: Write)
# 4. 생성 직후 한 번만 표시되는 sk-... 값을 복사
# 5. Settings → Billing 에서 결제 수단/크레딧이 등록되어 있어야 호출 가능
OPENAI_API_KEY=

# 사용할 모델 이름 (비워두면 코드 기본값 gpt-4o-mini 사용)
# 사용 가능한 모델: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini


# ---------------------------------------------------------------------
# 관리자 로그인 (/admin/login) — 외부 서비스가 아닌 직접 정하는 값
# ---------------------------------------------------------------------
# 관리자 로그인에 사용할 이메일과 비밀번호를 직접 정해서 입력
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 관리자 토큰(HMAC) 서명용 비밀값 — 32바이트 이상 무작위 문자열
# 생성: 터미널에서 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 바꾸면 기존 관리자 로그인 세션이 모두 무효화됨
AUTH_SECRET=


# ---------------------------------------------------------------------
# Pinata (IPFS) — 암호화된 스토리 본문 업로드
# ---------------------------------------------------------------------
# 1. https://app.pinata.cloud 로그인 (워크스페이스 Owner 또는 Admin)
# 2. 좌측 메뉴 Developers → API Keys → [+ New Key]
# 3. Admin 토글 ON (또는 Customize 에서 Files: Write + Gateways: Read 이상 부여)
#    → Key Name 입력 → [Create]
# 4. 표시되는 값 중 JWT (eyJ... 로 시작하는 긴 문자열)를 복사 — 창을 닫으면 다시 볼 수 없음
PINATA_JWT=

# 1. app.pinata.cloud 좌측 메뉴 Gateways
# 2. 목록의 게이트웨이 도메인을 https:// 없이 복사 (예: example-gateway.mypinata.cloud)
PINATA_GATEWAY=


# ---------------------------------------------------------------------
# 스토리 암호화 마스터키 — 외부 서비스가 아닌 직접 생성하는 값
# ---------------------------------------------------------------------
# 스토리마다 만드는 데이터 키를 잠그는 AES-256 마스터키 (64자리 hex = 32바이트)
# 생성: 터미널에서 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 주의: 이 값을 잃어버리면 저장된 모든 스토리를 영구히 복호화할 수 없음 → 안전한 곳에 별도 보관
#       한 번 정한 뒤에는 바꾸지 말 것 (바꾸면 기존 스토리 복호화 불가)
STORY_ENCRYPTION_KEY=


# ---------------------------------------------------------------------
# Supabase — 접속 키 · 스토리 메타데이터 · 매거진 저장 (storytech 스키마)
# 사전 작업: schema.sql 실행 + Exposed schemas 에 storytech 추가 (schema.sql 상단 주석 참고)
# ---------------------------------------------------------------------
# 1. https://supabase.com/dashboard 로그인 (조직의 Owner 또는 Administrator)
# 2. 프로젝트 선택 → 좌측 하단 Project Settings(톱니바퀴) → Data API
# 3. Project URL 값을 복사 (예: https://abcdefghijklmn.supabase.co)
SUPABASE_URL=

# 1. 같은 프로젝트의 Project Settings → API Keys
# 2. Secret keys 의 secret 키(sb_secret_...)를 [Reveal] 후 복사
#    — 화면에 Legacy API keys 탭만 있다면 service_role 키(eyJ...)를 복사
# 주의: RLS 를 우회하는 서버 전용 키. 브라우저 코드나 NEXT_PUBLIC_ 변수에 절대 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
